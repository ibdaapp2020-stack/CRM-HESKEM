# Neon / Postgres (SQLite file:./dev.db is not used in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Required. There is no default. Sessions are rejected when this is empty.
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_COOKIE="ibda_session"
PAYMENT_PROVIDER="sandbox"
# Required before /api/payments/webhook will update a payment.
# The caller signs the raw body with HMAC-SHA256 and sends it in x-payment-signature.
# PAYMENT_WEBHOOK_SECRET=""
WHATSAPP_PROVIDER="inbox"

# Local: http://localhost:3000
# Production: Firebase App Hosting URL after first deploy
NEXT_PUBLIC_APP_URL="http://localhost:3000"

WHATSAPP_VERIFY_TOKEN="ibda-wa-verify"
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# Required for inbound WhatsApp. Requests are rejected when this is empty.
# WHATSAPP_APP_SECRET=""
# Future: Israeli acquirer
# CARDCOM_TERMINAL=""
# TRANZILA_SUPPLIER=""
# MESHULAM_USER_ID=""
