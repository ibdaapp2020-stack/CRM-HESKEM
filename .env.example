# Cloud Firestore is the database. Configure the Firebase web app and Admin SDK.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Required. There is no default. Sessions are rejected when this is empty.
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_COOKIE="ibda_session"
PAYMENT_PROVIDER="sandbox"
# Required before /api/payments/webhook will update a payment.
# The caller signs the raw body with HMAC-SHA256 and sends it in x-payment-signature.
# PAYMENT_WEBHOOK_SECRET=""
WHATSAPP_PROVIDER="inbox"

# Local: http://localhost:3000
# Production: Firebase App Hosting URL after first deploy
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set a long random value in the host environment. Do not commit the real token.
# WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_BUSINESS_ACCOUNT_ID=""
# META_APP_SECRET=""
# Instagram Messaging. Leave empty until the Meta app is approved.
# INSTAGRAM_ACCESS_TOKEN=""
# INSTAGRAM_ACCOUNT_ID=""
# INSTAGRAM_LOGIN_MODE="instagram"
# Required for inbound WhatsApp. Requests are rejected when this is empty.
# WHATSAPP_APP_SECRET=""
# Future: Israeli acquirer
# CARDCOM_TERMINAL=""
# TRANZILA_SUPPLIER=""
# MESHULAM_USER_ID=""
