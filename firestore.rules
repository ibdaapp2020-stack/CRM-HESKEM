rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn() && request.auth.token.role == 'STAFF';
    }

    function isClient() {
      return signedIn() && request.auth.token.role == 'CLIENT';
    }

    function owns() {
      return isClient() && resource.data.clientUserId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == userId);
      allow write: if false;
    }

    match /leads/{leadId} {
      allow read: if isStaff() || owns();
      allow write: if isStaff();
    }

    match /documents/{documentId} {
      allow read: if isStaff() || owns();
      allow write: if isStaff();
    }

    match /questions/{questionId} {
      allow read: if isStaff() || owns();
      allow create, delete: if isStaff();
      allow update: if isStaff() || (
        owns()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'answeredAt'])
      );
    }

    match /projects/{projectId} {
      allow read: if isStaff() || owns();
      allow write: if isStaff();
    }

    match /payments/{paymentId} {
      allow read: if isStaff() || owns();
      allow write: if false;
    }

    match /appointments/{appointmentId} {
      allow read: if isStaff() || owns();
      allow write: if isStaff();
    }

    match /conversations/{conversationId} {
      allow read: if isStaff() || owns();
      allow write: if isStaff();
    }

    match /messages/{messageId} {
      allow read: if isStaff() || owns();
      allow write: if isStaff();
    }

    match /paymentMethods/{methodId} {
      allow read, write: if isStaff();
    }

    match /accesses/{accessId} {
      allow read, write: if isStaff();
    }

    match /settings/{key} {
      allow read, write: if isStaff();
    }

    match /signLinks/{token} {
      allow read, write: if false;
    }

    match /qualifications/{leadId} {
      allow read: if isStaff() || owns();
      allow write: if isStaff();
    }

    match /receipts/{receiptId} {
      allow read: if isStaff() || owns();
      allow write: if isStaff();
    }

    match /retainers/{planId} {
      allow read: if isStaff() || owns();
      allow write: if isStaff();
    }

    match /activities/{activityId} {
      allow read, write: if isStaff();
    }

    match /documentTemplates/{templateId} {
      allow read, write: if isStaff();
    }

    match /messageTemplates/{key} {
      allow read, write: if isStaff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
